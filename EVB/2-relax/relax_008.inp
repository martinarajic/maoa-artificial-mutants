[MD]
steps                   30000
stepsize                1
temperature             300
bath_coupling           100
separate_scaling        on
lrf                     on

[cut-offs]
q_atom                    99
solute_solute             10
solvent_solvent           10
solute_solvent            10

[intervals]
non_bond                 30
output                   1000
trajectory		 500

[lambdas]
1.0 0.0

[files]
restart		relax_007.re
restraint	relax_007.re.rest
topology        maoa_E446K.top
final           relax_008.re
trajectory	relax_008.dcd
fep             mao_sro_E446K.fep

[sequence_restraints]
# all
1    8302        0.5    0   0
