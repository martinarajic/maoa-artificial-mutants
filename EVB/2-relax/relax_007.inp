[MD]
steps                   30000
stepsize                1
temperature             150
bath_coupling           100
separate_scaling        on
lrf                     on

[cut-offs]
q_atom                    99
solute_solute             10
solvent_solvent           10
solute_solvent            10

[intervals]
non_bond                 30
output                   1000
trajectory		 500

[lambdas]
1.0 0.0

[files]
