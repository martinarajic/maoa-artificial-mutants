[MD]
steps                   50000
stepsize                0.1
temperature             1
bath_coupling           1
separate_scaling        on
lrf                     on
shake_solvent		off

[cut-offs]
q_atom                    99
solute_solute             10 
solvent_solvent           10 
solute_solvent            10

[intervals]
non_bond                 30
output                   10000
trajectory		 5000

[lambdas]
1.0 0.0

[files]
restart         relax_001c.re
restraint       relax_001c.re.rest
topology        maoa_E446K.top
final           relax_001d.re
trajectory	relax_001d.dcd
fep             mao_sro_E446K.fep

[sequence_restraints]
# all
1    8302        200   0   0
